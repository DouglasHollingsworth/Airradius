        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "AirRadius_evidencedStatement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceRefs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
