                "status": {
                  "type": "string",
                  "enum": [
                    "QUEUED",
                    "RUNNING",
                    "SUCCEEDED",
                    "FAILED",
                    "CANCELED",
                    "BLOCKED"
                  ]
                },
                "engine": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "provider": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "version",
                    "provider",
                    "model"
                  ],
                  "additionalProperties": false
                },
                "usage": {
                  "type": "object",
