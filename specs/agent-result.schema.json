{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AirRadius proposed agent run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "agentId",
    "caseId",
    "dataMode",
    "executionKind",
    "status",
    "startedAt",
    "finishedAt",
    "engine",
    "inputRefs",
    "facts",
    "inferences",
    "limitations",
    "recommendations",
    "usage",
    "approvalRequired",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "agentId": {
      "enum": [
        "digital-moc-coordinator",
        "sensor-fusion-analyst",
        "rf-em-awareness-analyst",
        "geospatial-analyst",
        "event-correlator",
        "operator-handoff-coordinator",
        "replay-aar-analyst",
        "open-source-integration-scout"
      ]
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "dataMode": {
      "enum": [
        "SIMULATED",
        "REPLAY",
        "LIVE"
      ]
    },
    "executionKind": {
      "enum": [
        "DETERMINISTIC",
        "LLM",
        "NOT_CONFIGURED"
      ]
    },
    "status": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED",
        "BLOCKED"
      ]
    },
    "startedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "finishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "provider",
        "model"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidencedStatement"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidencedStatement"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceRefs",
          "humanApprovalRequired"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "humanApprovalRequired": {
            "const": true
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "costUsd"
      ],
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "approvalRequired": {
      "const": true
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "evidencedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceRefs"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "SUCCEEDED"
          }
        }
      },
      "then": {
        "properties": {
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "inputRefs": {
            "minItems": 1
          },
          "executionKind": {
            "enum": [
              "DETERMINISTIC",
              "LLM"
            ]
          },
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionKind": {
            "const": "LLM"
          }
        }
      },
      "then": {
        "properties": {
          "engine": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "executionKind": {
            "const": "NOT_CONFIGURED"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          },
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "FAILED",
              "BLOCKED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
